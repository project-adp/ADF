{
	"name": "dataflowCopyManualDummy",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ExcelNewDescriptiveDummy",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable_NewDescriptiveInsight",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          VIN as string,",
				"          {Latest IG Off Date} as string,",
				"          {Production Year} as string,",
				"          {Telematics Subscription} as string,",
				"          {Dealer Origin} as string,",
				"          {Sales Date} as string,",
				"          Odometer as string,",
				"          {Most Visited Area} as string,",
				"          {All Time Avg KM/Trip} as string,",
				"          {Last Month Avg KM/Trip} as string,",
				"          {All Time Avg KM/Month} as string,",
				"          {Last Month Avg KM/Month} as string,",
				"          {All Time Avg Trip/Week} as string,",
				"          {Last Month Avg Trip/Week} as string,",
				"          {All Time Avg Idle Occurence/Week} as string,",
				"          {Last Month Avg Idle Occurence/Week} as string,",
				"          {All Time Avg Duration/Trip} as string,",
				"          {Last Month Avg Duration/Trip} as string,",
				"          {All Time Avg Speed/Trip} as string,",
				"          {Last Month Avg Speed/Trip} as string,",
				"          {Fuel Consumption (KM/L)} as string,",
				"          {Most Used Day} as string,",
				"          {Least Used Day} as string,",
				"          {Battery Voltage} as string,",
				"          {Intra City Trip Percentage} as string,",
				"          {Inter City Trip Percentage} as string,",
				"          {Harsh Acceleration/100KM} as string,",
				"          {Harsh Brake/100KM} as string,",
				"          {Harsh Cornering/100KM} as string,",
				"          {Current Active DTC Code} as string,",
				"          {Current Active DTC Category} as string,",
				"          {Current Active Warning} as string,",
				"          {Latest Collision History Detected} as string,",
				"          {Latest Service Date (GR)} as string,",
				"          {Latest Service Detail (GR)} as string,",
				"          {Latest Service Date (BP)} as string,",
				"          {Latest Service Detail (BP)} as string,",
				"          {Device Type} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive({Latest Collision History Detected} = iif(isInteger({Latest Collision History Detected}),{Latest Collision History Detected},'')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          vin as string,",
				"          latest_ig_off_date as long,",
				"          production_year as integer,",
				"          telematics_subscription as boolean,",
				"          dealer_origin as string,",
				"          sales_date as long,",
				"          odometer as integer,",
				"          most_visited_area as string,",
				"          all_time_avg_km_per_trip as double,",
				"          last_month_avg_km_per_trip as double,",
				"          all_time_avg_km_per_month as double,",
				"          last_month_avg_km_per_month as double,",
				"          all_time_avg_trips_per_week as double,",
				"          last_month_avg_trips_per_week as double,",
				"          all_time_avg_idle_occurrences_per_week as double,",
				"          last_month_avg_idle_occurrences_per_week as double,",
				"          all_time_avg_duration_per_trip as double,",
				"          last_month_avg_duration_per_trip as double,",
				"          all_time_avg_speed_per_trip as double,",
				"          last_month_avg_speed_per_trip as double,",
				"          fuel_consumption_km_per_liter as double,",
				"          most_used_day as string,",
				"          least_used_day as string,",
				"          battery_voltage as double,",
				"          intra_city_trip_percentage as double,",
				"          inter_city_trip_percentage as double,",
				"          harsh_acceleration_per_100_km as integer,",
				"          harsh_brake_per_100_km as integer,",
				"          harsh_cornering_per_100_km as integer,",
				"          current_active_dtc_code as string,",
				"          current_active_dtc_category as string,",
				"          current_active_warning as string,",
				"          latest_collision_history_detected as long,",
				"          latest_service_date_gr as long,",
				"          latest_service_detail_gr as string,",
				"          latest_service_date_bp as long,",
				"          latest_service_detail_bp as string,",
				"          device_type as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          vin = VIN,",
				"          latest_ig_off_date = {Latest IG Off Date},",
				"          production_year = {Production Year},",
				"          telematics_subscription = {Telematics Subscription},",
				"          dealer_origin = {Dealer Origin},",
				"          sales_date = {Sales Date},",
				"          odometer = Odometer,",
				"          most_visited_area = {Most Visited Area},",
				"          all_time_avg_km_per_trip = {All Time Avg KM/Trip},",
				"          last_month_avg_km_per_trip = {Last Month Avg KM/Trip},",
				"          all_time_avg_km_per_month = {All Time Avg KM/Month},",
				"          last_month_avg_km_per_month = {Last Month Avg KM/Month},",
				"          all_time_avg_trips_per_week = {All Time Avg Trip/Week},",
				"          last_month_avg_trips_per_week = {Last Month Avg Trip/Week},",
				"          all_time_avg_idle_occurrences_per_week = {All Time Avg Idle Occurence/Week},",
				"          last_month_avg_idle_occurrences_per_week = {Last Month Avg Idle Occurence/Week},",
				"          all_time_avg_duration_per_trip = {All Time Avg Duration/Trip},",
				"          last_month_avg_duration_per_trip = {Last Month Avg Duration/Trip},",
				"          all_time_avg_speed_per_trip = {All Time Avg Speed/Trip},",
				"          last_month_avg_speed_per_trip = {Last Month Avg Speed/Trip},",
				"          fuel_consumption_km_per_liter = {Fuel Consumption (KM/L)},",
				"          most_used_day = {Most Used Day},",
				"          least_used_day = {Least Used Day},",
				"          battery_voltage = {Battery Voltage},",
				"          intra_city_trip_percentage = {Intra City Trip Percentage},",
				"          inter_city_trip_percentage = {Inter City Trip Percentage},",
				"          harsh_acceleration_per_100_km = {Harsh Acceleration/100KM},",
				"          harsh_brake_per_100_km = {Harsh Brake/100KM},",
				"          harsh_cornering_per_100_km = {Harsh Cornering/100KM},",
				"          current_active_dtc_code = {Current Active DTC Code},",
				"          current_active_dtc_category = {Current Active DTC Category},",
				"          current_active_warning = {Current Active Warning},",
				"          latest_collision_history_detected = {Latest Collision History Detected},",
				"          latest_service_date_gr = {Latest Service Date (GR)},",
				"          latest_service_detail_gr = {Latest Service Detail (GR)},",
				"          latest_service_date_bp = {Latest Service Date (BP)},",
				"          latest_service_detail_bp = {Latest Service Detail (BP)},",
				"          device_type = {Device Type}",
				"     )) ~> sink1"
			]
		}
	}
}